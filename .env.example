# Umami Analytics
# Create a website in Umami and paste its Website ID here.
PUBLIC_UMAMI_WEBSITE_ID=

# Umami Cloud default. Change only if you self-host Umami.
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Optional: only track production domains, comma-separated.
# This prevents localhost/dev pageviews from being counted.
PUBLIC_UMAMI_DOMAINS=agimenezromero.github.io
