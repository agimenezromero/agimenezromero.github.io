---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  prefix: string;
  alt: string;
  interval?: number;
}

const {
  prefix,
  alt,
  interval = 6000,
} = Astro.props;


/*
 * Import every research image in the folder.
 *
 * Individual files do NOT need to be imported manually.
 */
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{png,jpg,jpeg,webp,avif}',
  {
    eager: true,
  }
);


/*
 * Find:
 *
 * prefix-1.png
 * prefix-2.png
 * prefix-3.png
 * ...
 *
 * The extension can also be jpg, jpeg, webp or avif.
 */
const escapedPrefix = prefix.replace(
  /[.*+?^${}()|[\]\\]/g,
  '\\$&'
);

const pattern = new RegExp(
  `^${escapedPrefix}-(\\d+)\\.(png|jpe?g|webp|avif)$`,
  'i'
);


const images = Object.entries(imageModules)
  .filter(([path]) => {
    const filename = path.split('/').pop() ?? '';
    return pattern.test(filename);
  })
  .sort(([pathA], [pathB]) => {
    const filenameA = pathA.split('/').pop() ?? '';
    const filenameB = pathB.split('/').pop() ?? '';

    const numberA =
      Number(filenameA.match(pattern)?.[1]) || 0;

    const numberB =
      Number(filenameB.match(pattern)?.[1]) || 0;

    return numberA - numberB;
  })
  .map(([, module]) => module.default);


if (images.length === 0) {
  throw new Error(
    `No images found for "${prefix}". ` +
    `Expected files such as src/assets/images/${prefix}-1.png`
  );
}
---

<div
  class="theme-visual research-carousel"
  data-research-carousel
  data-interval={interval}
>
  <div
    class="research-carousel-images"
    aria-live="off"
  >
    {images.map((image, index) => (
      <div
        class:list={[
          'research-carousel-slide',
          { 'is-active': index === 0 },
        ]}
        data-carousel-slide
        aria-hidden={index === 0 ? 'false' : 'true'}
      >
        <Image
          src={image}
          alt={`${alt}${images.length > 1 ? ` — image ${index + 1}` : ''}`}
          widths={[600, 900, 1200, 1600]}
          sizes="(min-width: 900px) 55vw, 94vw"
        />
      </div>
    ))}
  </div>


  {images.length > 1 && (
    <div
      class="research-carousel-dots"
      aria-label="Select research image"
    >
      {images.map((_, index) => (
        <button
          type="button"
          class:list={[
            'research-carousel-dot',
            { 'is-active': index === 0 },
          ]}
          data-carousel-dot={index}
          aria-label={`Show image ${index + 1} of ${images.length}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        />
      ))}
    </div>
  )}
</div>


<script>
  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  );

  const carousels =
    document.querySelectorAll<HTMLElement>(
      '[data-research-carousel]'
    );


  carousels.forEach((carousel) => {
    const slides = Array.from(
      carousel.querySelectorAll<HTMLElement>(
        '[data-carousel-slide]'
      )
    );

    const dots = Array.from(
      carousel.querySelectorAll<HTMLButtonElement>(
        '[data-carousel-dot]'
      )
    );


    /*
     * One image = ordinary static image.
     */
    if (slides.length <= 1) return;


    let current = 0;
    let timer: number | undefined;

    const interval =
      Number(carousel.dataset.interval) || 6000;


    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        const active = i === index;

        slide.classList.toggle(
          'is-active',
          active
        );

        slide.setAttribute(
          'aria-hidden',
          active ? 'false' : 'true'
        );

        if (dots[i]) {
          dots[i].classList.toggle(
            'is-active',
            active
          );

          dots[i].setAttribute(
            'aria-pressed',
            active ? 'true' : 'false'
          );
        }
      });

      current = index;
    }


    function nextSlide() {
      showSlide(
        (current + 1) % slides.length
      );
    }


    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }


    function start() {
      stop();

      if (reduceMotion.matches) return;

      timer = window.setInterval(
        nextSlide,
        interval
      );
    }


    /*
     * Manual navigation using the dots.
     */
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showSlide(index);

        /*
         * Restart the timer after manual selection.
         */
        start();
      });
    });


    /*
     * Pause while hovering or interacting.
     */
    carousel.addEventListener(
      'mouseenter',
      stop
    );

    carousel.addEventListener(
      'mouseleave',
      start
    );

    carousel.addEventListener(
      'focusin',
      stop
    );

    carousel.addEventListener(
      'focusout',
      start
    );


    start();
  });
</script>