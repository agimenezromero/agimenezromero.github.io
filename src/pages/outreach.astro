---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { conversation, managementBriefs, media } from '@/data/outreach';
---
<BaseLayout title="Outreach" description="Science communication, management briefs, interviews and media coverage.">
  <header class="page-intro shell">
    <p class="eyebrow">Outreach</p>
    <h1>Science beyond<br />the research paper</h1>
    <p class="page-lede">I write and speak about ecological modelling, biodiversity, climate change and environmental observation for non-specialist audiences, through authored articles, decision-oriented briefs, interviews and media coverage.</p>
  </header>

  <section class="shell outreach-page-section">
    <div class="section-grid-heading"><div><p class="eyebrow">Authored</p><h2>The Conversation</h2></div><p>Research translated into accessible arguments, without removing the scientific mechanism.</p></div>
    <div class="editorial-list">
      {conversation.map(item => (
        <article class="editorial-item"><span class="editorial-year">{item.year}</span><div><p class="eyebrow">{item.outlet}</p><h3>{item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer" data-umami-event="outreach-open" data-umami-event-title={item.title}>{item.title}</a> : item.title}</h3><p>{item.topic}</p></div><span class="editorial-arrow">{item.href ? '↗' : ''}</span></article>
      ))}
    </div>
  </section>

  <section class="outreach-alt"><div class="shell outreach-page-section">
    <div class="section-grid-heading"><div><p class="eyebrow">Knowledge transfer</p><h2>Briefs for management</h2></div><p>Concise, decision-oriented summaries produced for Prismàtic.</p></div>
    <div class="brief-grid">{managementBriefs.map(item => <article><span>{item.year}</span><h3>{item.title}</h3><p>{item.outlet}</p></article>)}</div>
  </div></section>

  <section class="shell outreach-page-section">
    <div class="section-grid-heading"><div><p class="eyebrow">Coverage</p><h2>Interviews & media</h2></div><p>Selected interviews, reports and independent coverage of the research.</p></div>
    <div class="media-list">{media.map(item => <article><span>{item.year}</span><div><strong>{item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer" data-umami-event="media-open" data-umami-event-title={item.title}>{item.title}</a> : item.title}</strong><p>{item.outlet}</p></div></article>)}</div>
  </section>
</BaseLayout>
